<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deliberately NO INTERNET, ACCESS_NETWORK_STATE or external storage permission. -->
    <application
        android:allowBackup="false"
        android:label="BF Offline Prototype"
        android:icon="@android:drawable/ic_menu_compass"
        android:theme="@style/BfOfflineTheme">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
